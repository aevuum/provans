{
  "name": "provance-decor",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "18.x"
  },
  "scripts": {
    "predev": "tsx scripts/generate-photos-manifest.ts",
    "dev": "next dev",
    "test:unit": "vitest",
    "prebuild": "tsx scripts/generate-photos-manifest.ts",
    "build": "npm run db:generate && next build",
    "render:build": "npm ci --only=production && npx prisma generate --schema ../../src/prisma/schema.prisma && npx prisma migrate deploy --schema ../../src/prisma/schema.prisma && next build",
    "db:migrate:deploy": "npx prisma migrate deploy --schema ../../src/prisma/schema.prisma",
    "start": "next start",
    "lint": "next lint",
    "import:products": "tsx scripts/import-products.ts",
    "import:json": "tsx scripts/import-from-json.ts",
    "categories:analyze": "node scripts/analyze-categories.js",
    "categories:normalize": "node scripts/normalize-categories.js",
    "db:push": "prisma db push",
    "db:generate": "npx prisma generate --schema ../../src/prisma/schema.prisma",
    "db:studio": "prisma studio",
    "studio:autostart": "node scripts/start-studio-with-postgres.js",
    "update:categories": "tsx scripts/update-categories-from-old.ts",
    "moderation:find-dups": "tsx scripts/moderation/find-duplicates.ts",
    "moderation:remove-dups": "tsx scripts/moderation/remove-duplicates.ts --apply",
    "moderation:cleanup-placeholders": "tsx scripts/moderation/cleanup-placeholders.ts",
    "images:unused": "tsx scripts/maintenance/find-unused-images.ts",
    "images:archive": "tsx scripts/maintenance/archive-unused-images.ts"
  },
  "overrides": {
    "debug": "^4.3.5",
    "color-name": "^1.1.4",
    "color-convert": "^2.0.1",
    "is-arrayish": "^0.3.2",
    "xml2js": "^0.6.2",
    "tough-cookie": "^4.1.4",
    "@types/next-auth": "^3.15.0",
    "jose": "^5.9.6"
  },
  "dependencies": {
    "@a2seven/yoo-checkout": "^1.1.4",
    "@auth/prisma-adapter": "^2.10.0",
    "@nestjs/mapped-types": "*",
    "@prisma/client": "^6.15.0",
    "@react-icons/all-files": "^4.1.0",
    "@reduxjs/toolkit": "^2.8.2",
    "@tailwindcss/postcss": "^4.1.12",
    "@tanstack/react-query": "^5.85.5",
    "@types/next-auth": "^3.15.0",
    "@types/nodemailer": "^6.4.17",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "csv-parse": "^6.1.0",
    "express": "^5.1.0",
    "lucide-react": "^0.536.0",
    "nestjs": "^0.0.1",
    "nestjs-yookassa": "^1.1.28",
    "next": "^15.4.6",
    "next-auth": "^4.24.11",
    "nodemailer": "^6.10.1",
    "postcss": "^8.5.6",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-icons": "^5.5.0",
    "react-markdown": "^10.1.0",
    "react-redux": "^9.2.0",
    "react-toastify": "^11.0.5",
    "redux-persist": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "simple-icons": "^15.9.0",
    "uuid": "^11.1.0",
    "yookassa": "^0.1.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/typography": "^0.5.15",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^20.19.9",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@types/uuid": "^10.0.0",
    "eslint": "^9",
    "eslint-config-next": "15.4.4",
    "prisma": "^6.13.0",
    "tailwindcss": "^4.1.12",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vitest": "^1.3.3"
  }
}
