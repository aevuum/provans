{
  "name": "provans-decor",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm --prefix src/frontend run dev",
    "build": "npm --prefix src/frontend install --omit=dev && npm --prefix src/frontend run build",
    "predev": "tsx src/frontend/scripts/generate-photos-manifest.ts",
    "build:frontend": "npm --prefix src/frontend run build",
    "build:prod": "NODE_ENV=production npm run build",
    "start": "npm --prefix src/frontend run start -p $PORT",
    "test:unit": "npm --prefix src/frontend run test:unit",
    "prebuild": "tsx src/frontend/scripts/generate-photos-manifest.ts",
    "lint": "next lint",
    "import:products": "tsx src/frontend/scripts/import-products.ts",
    "import:json": "tsx src/scripts/import-from-json.ts",
    "categories:analyze": "node scripts/analyze-categories.js",
    "categories:normalize": "node scripts/normalize-categories.js",
    "db:generate": "prisma generate --schema src/prisma/schema.prisma",
    "db:push": "prisma db push --schema src/prisma/schema.prisma",
    "db:studio": "prisma studio --schema src/prisma/schema.prisma",
    "update:categories": "tsx src/frontend/scripts/update-categories-from-old.ts",
    "moderation:find-dups": "tsx src/frontend/scripts/moderation/find-duplicates.ts",
    "moderation:remove-dups": "tsx src/frontend/scripts/moderation/remove-duplicates.ts --apply",
    "moderation:cleanup-placeholders": "tsx src/frontend/scripts/moderation/cleanup-placeholders.ts",
    "admin:ensure": "tsx src/scripts/moderation/create-or-update-admin.ts"
  },
  "dependencies": {
    "@a2seven/yoo-checkout": "^1.1.4",
    "@auth/prisma-adapter": "^2.10.0",
    "@nestjs/mapped-types": "*",
    "@prisma/client": "^6.16.2",
    "@react-icons/all-files": "^4.1.0",
    "@reduxjs/toolkit": "^2.8.2",
    "@tanstack/react-query": "^5.85.5",
    "@types/next-auth": "^3.15.0",
    "@types/nodemailer": "^6.4.17",
    "@types/uuid": "^10.0.0",
    "bcryptjs": "^3.0.2",
    "csv-parse": "^6.1.0",
    "lucide-react": "^0.536.0",
    "nestjs": "^0.0.1",
    "nestjs-yookassa": "^1.1.28",
    "next": "^15.4.6",
    "next-auth": "^4.24.11",
    "nodemailer": "^6.10.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-icons": "^5.5.0",
    "react-redux": "^9.2.0",
    "react-toastify": "^11.0.5",
    "redux-persist": "^6.0.0",
    "simple-icons": "^15.9.0",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.19.9",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "eslint": "^9",
    "eslint-config-next": "15.4.4",
    "prisma": "^6.15.0",
    "tailwindcss": "^4",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  },
  "overrides": {
    "debug": "^4.3.5",
    "color-name": "^1.1.4",
    "color-convert": "^2.0.1",
    "is-arrayish": "^0.3.2",
    "xml2js": "^0.6.2",
    "tough-cookie": "^4.1.4",
    "@types/next-auth": "^3.15.0",
    "jose": "^5.9.6"
  },
  "engines": {
    "node": ">=18"
  }
}
