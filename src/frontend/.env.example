# ================== REQUIRED BACKEND / PAYMENT ==================
# YooKassa (основные реквизиты)
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# Альтернативные ключи (если в окружении используются опечатки YOOKASA_*)
# YOOKASA_SHOP_ID=
# YOOKASA_SECRET_KEY=

# Секрет для HMAC подписи webhook (кастомная, если решите включить)
YOOKASSA_WEBHOOK_SECRET=

# ================== APP / SITE CONFIG ==================
NEXTAUTH_SECRET=
NEXTAUTH_URL=
NEXT_PUBLIC_SITE_URL=

# ================== DATABASE ==================
DATABASE_URL=
PRISMA_REQUIRE_DB=false # true = билд/рантайм должны упасть если нет соединения
PRISMA_ALLOW_STUB_POSTGRES=true # true = разрешает безопасный stub для readonly страниц

# ================== EMAIL ==================
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

# ================== SECURITY OPTIONS ==================
# Разрешённые домены для CORS / формирования URL
ALLOWED_ORIGINS=
# Принудительное включение продакшн заголовков (true/false)
SECURITY_HEADERS_ENABLED=true

# ================== OPTIONAL ==================
# Режим логирования (debug, info, warn, error)
LOG_LEVEL=info

# ================== RUNTIME FEATURE FLAGS (опционально) ==================
# Пример: включение экспериментальных функций. Добавляйте здесь, не вшивайте в код.
# FEATURE_EXAMPLE=false
