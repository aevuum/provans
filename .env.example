# Database (compose uses internal host `postgres` and default port 5432)
DATABASE_URL=postgresql://provans:provans@postgres:5432/provans?schema=public
POSTGRES_DB=provans
POSTGRES_USER=provans
POSTGRES_PASSWORD=provans
POSTGRES_PORT=5432

# Next.js / NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace_with_strong_secret

# SMTP (Nodemailer)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=user@example.com
SMTP_PASS=your_password
SMTP_FROM="Provans Decor <no-reply@provans.ru>"

# YooKassa
YOOKASSA_SHOP_ID=your_shop_id
YOOKASSA_SECRET_KEY=your_secret_key
YOOKASSA_WEBHOOK_SECRET=replace_with_webhook_secret

# App
APP_BASE_URL=http://localhost:3000
# For frontend running inside compose, access backend via service name
NEXT_PUBLIC_API_URL=http://backend:3001

# Backend CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
